{
    "version": 2,
    "builds": [
        {
            "src": "src/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "methods": [
                "OPTIONS"
            ],
            "status": 204
        },
        {
            "src": "/(.*)",
            "dest": "src/index.ts"
        }
    ]
}